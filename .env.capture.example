# Generate .env.capture using README.capture.zh-CN.md; do not commit real secrets.
# Keep these values and all archive volumes when updating the deployment.
CONTENT_ARCHIVE_KEY=
CAPTURE_POSTGRES_PASSWORD=
CONTENT_ARCHIVE_S3_ACCESS_KEY=
CONTENT_ARCHIVE_S3_SECRET_KEY=
CAPTURE_KAFKA_CLUSTER_ID=

CONTENT_ARCHIVE_TOPIC=omnivo.request-content.v1
CONTENT_ARCHIVE_GROUP=omnivo-content-archiver
CONTENT_ARCHIVE_S3_BUCKET=omnivo-request-content

# Bounded gateway buffering. These are starting limits, not a throughput promise.
CONTENT_ARCHIVE_MAX_BUFFERED_BYTES=33554432
CONTENT_ARCHIVE_MAX_ACTIVE=1024
CONTENT_ARCHIVE_CHUNK_BYTES=32768
CONTENT_ARCHIVE_FLUSH_INTERVAL_MS=100
CONTENT_ARCHIVE_MAX_BATCH_BYTES=4194304
CONTENT_ARCHIVE_MAX_POLL_RECORDS=256
